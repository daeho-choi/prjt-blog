---
import 'pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css';
import '../styles/global.css';
import { caseStudies } from '../data/case-studies';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'daeho-choi · PM portfolio',
  description = 'PM daeho-choi의 프로젝트 케이스 스터디와 포트폴리오.',
} = Astro.props;

const base = import.meta.env.BASE_URL;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : Astro.url.pathname;

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const basePath = base.replace(/\/+$/, '') || '/';
const isHome = path === basePath || path === '/';
const isCaseStudies = path.startsWith(`${basePath}/case-studies`);
const isPortfolio = path.startsWith(`${basePath}/portfolio`);
const isAbout = path.startsWith(`${basePath}/about`);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0b" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={base}>daeho-choi<span class="brand-dot">.</span></a>
      <nav>
        <a href={base} aria-current={isHome ? 'page' : undefined}>Home</a>
        <div class="nav-dropdown">
          <a
            href={`${base}case-studies/`}
            class="nav-dropdown-trigger"
            aria-current={isCaseStudies ? 'page' : undefined}
            aria-haspopup="true"
          >
            Case Studies
            <svg
              class="nav-chev"
              width="10"
              height="10"
              viewBox="0 0 10 10"
              aria-hidden="true"
            >
              <path d="M2 4l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
          <div class="nav-dropdown-menu" role="menu">
            {
              caseStudies.map((cs) => (
                <a
                  class="nav-dropdown-item"
                  href={`${base}case-studies/${cs.slug}/`}
                  role="menuitem"
                  style={`--accent: ${cs.accent}`}
                >
                  <span class="nav-dropdown-dot" aria-hidden="true" />
                  <span class="nav-dropdown-text">
                    <span class="nav-dropdown-title">{cs.title}</span>
                    <span class="nav-dropdown-sub">{cs.year}</span>
                  </span>
                </a>
              ))
            }
            <a class="nav-dropdown-all" href={`${base}case-studies/`} role="menuitem">
              All case studies →
            </a>
          </div>
        </div>
        <a href={`${base}portfolio/`} aria-current={isPortfolio ? 'page' : undefined}>CV</a>
        <a href={`${base}about/`} aria-current={isAbout ? 'page' : undefined}>About</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <small>
        © {new Date().getFullYear()} daeho-choi ·
        <a href="https://github.com/daeho-choi/prjt-blog" target="_blank" rel="noopener">GitHub ↗</a>
      </small>
    </footer>
  </body>
</html>
