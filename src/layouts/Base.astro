---
import 'pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'daeho-choi · PM portfolio',
  description = 'PM daeho-choi의 프로젝트 케이스 스터디와 포트폴리오.',
} = Astro.props;

const base = import.meta.env.BASE_URL;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : Astro.url.pathname;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0b" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={base}>daeho-choi<span class="brand-dot">.</span></a>
      <nav>
        <a href={base}>Home</a>
        <a href={`${base}case-studies/`}>Case Studies</a>
        <a href={`${base}portfolio/`}>CV</a>
        <a href={`${base}about/`}>About</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <small>
        © {new Date().getFullYear()} daeho-choi ·
        <a href="https://github.com/daeho-choi/prjt-blog">GitHub</a>
      </small>
    </footer>
  </body>
</html>
