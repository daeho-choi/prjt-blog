---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL;
---

<Base title="daeho-choi · PM portfolio">
  <section class="landing">
    <p class="landing-kicker">DEVELOPMENT PM · 7 YEARS</p>
    <h1>
      제품을 만드는 PM,<br />
      <span class="landing-accent">최대호</span> 입니다.
    </h1>
    <p class="landing-tagline">
      기획부터 실행, 그리고 런칭 이후의 학습까지 —<br />
      라이브 게임 · 플랫폼 · 0→1 서비스를 거치며 남긴 기록을 모읍니다.
    </p>
    <div class="landing-cta">
      <a class="btn btn-primary" href={`${base}portfolio/`}>View CV →</a>
      <a class="btn btn-ghost" href={`${base}case-studies/`}>Case Studies</a>
    </div>
  </section>
</Base>
