---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL;

const featured = [
  {
    slug: 'tikit',
    title: 'TIKIT',
    subtitle: '티켓처럼 공유하는 한국어 이벤트 초대장.',
    role: '기획 · 개발 · 디자인',
    year: '2026',
    accent: '#818CF8',
  },
  {
    slug: 'boombim',
    title: '붐빔 BoomBim',
    subtitle: '오프라인의 복작거림을 온라인에서도.',
    role: 'PM · 기획',
    year: '2025',
    accent: '#FF6B35',
  },
  {
    slug: 'lokit',
    title: 'LOKIT',
    subtitle: '잠긴 선물카드를 링크로 주고받는 모바일 웹.',
    role: 'PM · 기획',
    year: '2025',
    accent: '#00FFD1',
  },
];
---

<Base title="daeho-choi · PM portfolio">
  <section class="landing">
    <p class="landing-kicker">DEVELOPMENT PM · 7 YEARS</p>
    <h1>
      제품을 만드는 PM,<br />
      <span class="landing-accent">daeho-choi.</span>
    </h1>
    <p class="landing-tagline">
      기획부터 실행, 그리고 런칭 이후의 학습까지 —<br />
      라이브 게임 · 플랫폼 · 0→1 서비스를 거치며 남긴 기록을 모읍니다.
    </p>
    <div class="landing-cta">
      <a class="btn btn-primary" href={`${base}portfolio/`}>View CV →</a>
      <a class="btn btn-ghost" href={`${base}case-studies/`}>Case Studies</a>
    </div>
  </section>

  <section>
    <div class="section-head">
      <span class="section-label">RECENT WORK</span>
      <a class="section-link" href={`${base}case-studies/`}>All case studies →</a>
    </div>
    <div class="grid">
      {
        featured.map((cs) => (
          <a
            class="card"
            href={`${base}case-studies/${cs.slug}/`}
            style={`--accent: ${cs.accent}`}
          >
            <span class="card-meta">
              {cs.year} · {cs.role}
            </span>
            <h3>{cs.title}</h3>
            <p>{cs.subtitle}</p>
            <span class="arrow">Read →</span>
          </a>
        ))
      }
    </div>
  </section>
</Base>
