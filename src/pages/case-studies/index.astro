---
import Base from '../../layouts/Base.astro';
import { caseStudies } from '../../data/case-studies';

const base = import.meta.env.BASE_URL;
---

<Base
  title="Case Studies · daeho-choi"
  description="daeho-choi의 사이드 프로젝트 PRD와 케이스 스터디 모음."
>
  <section class="hero page-hero">
    <div class="page-hero-head">
      <p class="landing-kicker">CASE STUDIES</p>
      <h1>
        <span class="headline-lead">혼자 만든,</span>
        <span class="headline-subject">Case Studies.</span>
      </h1>
    </div>
    <div class="page-hero-body">
      <p class="page-hero-sub">
        기획·구현·런칭까지 — 소규모로 만든 사이드 프로젝트의 짧은 기록입니다.
      </p>
    </div>
  </section>

  <section>
    <div class="grid">
      {
        caseStudies.map((cs) => (
          <a
            class="card"
            href={`${base}case-studies/${cs.slug}/`}
            style={`--accent: ${cs.accent}`}
          >
            <span class="card-meta">{cs.year}</span>
            <h3>{cs.title}</h3>
            <p>{cs.subtitle}</p>
            <span class="arrow">Read →</span>
          </a>
        ))
      }
    </div>
  </section>
</Base>
