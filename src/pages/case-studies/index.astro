---
import Base from '../../layouts/Base.astro';
import { caseStudies } from '../../data/case-studies';

const base = import.meta.env.BASE_URL;
---

<Base
  title="Case Studies · daeho-choi"
  description="daeho-choi의 사이드 프로젝트 PRD와 케이스 스터디 모음."
>
  <section class="hero">
    <h1>Case Studies</h1>
    <p class="tagline">
      혼자 또는 소규모 팀으로 만든 사이드 프로젝트의 기획·구현·런칭 기록입니다.
    </p>
  </section>

  <section>
    <div class="grid">
      {
        caseStudies.map((cs) => (
          <a
            class="card"
            href={`${base}case-studies/${cs.slug}/`}
            style={`--accent: ${cs.accent}`}
          >
            <span class="card-meta">{cs.year}</span>
            <h3>{cs.title}</h3>
            <p>{cs.subtitle}</p>
            <span class="arrow">Read →</span>
          </a>
        ))
      }
    </div>
  </section>
</Base>
